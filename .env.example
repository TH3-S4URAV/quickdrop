# QuickDrop Configuration
PORT=4173
PUBLIC_BASE_URL=
MAX_FILE_SIZE_BYTES=10737418240
CHUNK_SIZE_BYTES=5242880
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string

# Storage Settings
# Options: local | s3
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# S3 / Cloudflare R2 Settings (if STORAGE_BACKEND=s3)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=quickdrop
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
